# Shared signaling store (Upstash Redis REST)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Cloudflare Realtime TURN (optional, required for reliable cross-network transfer)
TURN_KEY_ID=
TURN_KEY_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ANALYTICS_API_TOKEN=

# Relay controls
RELAY_ADMIN_TOKEN=
TURN_ENABLED=0
TURN_MONTHLY_LIMIT_GB=800

# Optional canonical public URL, for example https://relay.example.com
PUBLIC_ORIGIN=

# Room lifetime: up to 24 hours before confirmation, 20 minutes after confirmation
ROOM_TTL_MS=86400000
CONFIRMED_ROOM_TTL_MS=1200000

# Advanced alternative to Cloudflare TURN: JSON array of RTCIceServer objects
ICE_SERVERS_JSON=
